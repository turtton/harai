{
  "name": "backend",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/copy-frontend-assets.js",
    "preview": "wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "deploy:staging": "bun run build && wrangler deploy --config wrangler.staging.jsonc",
    "deploy:production": "bun run build && wrangler deploy --config wrangler.production.jsonc",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/",
    "ci": "biome check src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "wrangler types && tsc --noEmit",
    "generate-types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.5",
    "hono": "4.9.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^12.6.7",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-kit": "^0.31.4",
    "happy-dom": "^14.0.0",
    "tsx": "^4.20.5",
    "wrangler": "^4.4.0"
  }
}